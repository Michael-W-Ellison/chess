  "greetings": [
    [
      "^h+i+$",
      "hi"
    ],
    [
      "^h+e+y+$",
      "hey"
    ],
    [
      "^h+e+l+o+$",
      "hello"
    ],
    [
      "^b+y+e+$",
      "bye"
    ],
    [
      "^y+o+$",
      "yo"
    ]
  ],
  "steps": [
    {
      "note": "\"hiiii\", \"heyyy\", \"byeee\": the greeting the stretched word is",
      "code": "stretched_greetings",
      "examples": [
        [
          "hiiii",
          "hi"
        ],
        [
          "heyyy buddy",
          "hey buddy"
        ],
        [
          "byeeee",
          "bye"
        ]
      ]
    },
    {
      "note": "Shorthand with digits (\"b4\", \"2day\", \"l8r\"), which the word step does not see",
      "code": "digit_shorthand",
      "examples": [
        [
          "see u l8r",
          "see you later"
        ],
        [
          "2day was fun",
          "today was fun"
        ]
      ]
    },
    {
      "note": "Child spellings, word by word (the \"words\" table); spellings first, so \"its rlly big\" reads \"its really big\" before \"its\" -> \"it's\". \"ur\" is left for the steps below",
      "code": "words",
      "examples": [
        [
          "k",
          "ok"
        ],
        [
          "jk",
          "just kidding"
        ]
      ]
    },
    {
      "note": "\"to much homework\", \"it's to hot\"; not after a verb of going (\"we went to Big Bear\")",
      "pattern": "\\b(\\w+) to(?= (much|hot|cold|big|small|hard|scary|loud|late|early|tired|full|long|fast|slow|short|high|heavy|far|young|old|spicy|sweet|bright|dark)\\b)",
      "ignore_case": true,
      "template": "{1} too",
      "keep_if_group_matches": {
        "group": 1,
        "pattern": "(go|goes|going|went|gone|come|came|coming|walk|walked|drive|drove|ran|run|moved?|travel|flew|fly|trip|visit|back|way|road|welcome|next|due|according|close|up|down|out|over|on|from)$",
        "ignore_case": true
      },
      "examples": [
        [
          "its to hot outside",
          "it's too hot outside"
        ],
        [
          "i have to much homework",
          "I have too much homework"
        ]
      ]
    },
    {
      "note": "\"its so fun\" -> \"it's so fun\"",
      "pattern": "\\bits(?= (so|really|very|not|too|just|a|an|the|my|ok|okay|fine|fun|boring|hard|easy|cool|great|good|bad|true|time|going|gonna|like|always|never|raining|snowing|gross|yummy|awesome|amazing|weird|scary|funny|cute|about|mine|yours|over|super|kind|pretty|beautiful|ugly|big|bigger|small|smaller|huge|tiny|heavy|soft|red|orange|yellow|green|blue|purple|pink|brown|black|white|gray|grey|sticky|shiny|sparkly|broken|done|finished|lost|gone|made|called|still|almost|my)\\b)",
      "ignore_case": true,
      "replace": "it's",
      "examples": [
        [
          "its huge",
          "it's huge"
        ],
        [
          "its a boy",
          "it's a boy"
        ]
      ]
    },
    {
      "note": "\"ur weird\" -> \"you're weird\"",
      "pattern": "\\bur(?= (so|really|very|not|the|a|an|my|weird|cool|funny|nice|mean|smart|awesome|silly|dumb|stupid|annoying|best|worst|welcome|right|wrong|crazy|lying|kidding|joking|amazing|great|good|bad|too)\\b)",
      "ignore_case": true,
      "replace": "you're",
      "examples": [
        [
          "ur weird",
          "you're weird"
        ],
        [
          "jk ur cool",
          "just kidding you're cool"
        ]
      ]
    },
    {
      "note": "\"your so funny\", \"your the best\"; an adjective only at the end (\"your funny face\" stays)",
      "pattern": "\\byour(?= (so|really|very|not|the|a|an|too|being|going|gonna|welcome|always|never|my|such|kidding|joking|lying)\\b|(?= (funny|silly|cool|nice|mean|smart|awesome|weird|dumb|cute|amazing|annoying|right|wrong|crazy|great|best|the best)\\s*[.!?]*$))",
      "ignore_case": true,
      "replace": "you're",
      "examples": [
        [
          "your so funny",
          "you're so funny"
        ],
        [
          "your the best",
          "you're the best"
        ]
      ]
    },
    {
      "note": "\"I could of won\" -> \"I could have won\"",
      "pattern": "\\b(could|would|should|must|might) of\\b",
      "ignore_case": true,
      "replace": "\\1 have",
      "examples": [
        [
          "i could of won",
          "I could have won"
        ]
      ]
    },
    {
      "note": "\"lets play\" -> \"let's play\"",
      "pattern": "\\blets(?= (play|go|do|make|watch|build|talk|be|see|try|have|pretend|sing|draw|read)\\b)",
      "ignore_case": true,
      "replace": "let's",
      "examples": [
        [
          "lets play tag",
          "let's play tag"
        ],
        [
          "lets be friends",
          "let's be friends"
        ]
      ]
    },
    {
      "note": "\"ill try\" -> \"I'll try\"",
      "pattern": "\\bill(?= (try|do|be|go|ask|tell|practice|study|see|talk|play|have|get|make|show|let|just|never|always|probably|draw|read|call|text|come|help|work|remember|eat|drink|wait|clean|finish|sleep|bring|buy|use|build|write|stop|take|give|send|keep|think|put|pick|sit|stay|watch|listen|look|fix|share|win|beat|check|miss|need|wear|sing|dance|run|swim|ride)\\b)",
      "ignore_case": true,
      "replace": "I'll",
      "examples": [
        [
          "ok ill try that",
          "ok I'll try that"
        ],
        [
          "fine ill eat broccoli",
          "fine I'll eat broccoli"
        ]
      ]
    },
    {
      "note": "Any other \"ur\" is \"your\" (\"ur dog\")",
      "pattern": "\\bur\\b",
      "ignore_case": true,
      "replace": "your",
      "examples": [
        [
          "ur dog",
          "your dog"
        ]
      ]
    },
    {
      "note": "\"my moms room\" -> \"my mom's room\"",
      "pattern": "\\b(mom|dad|mommy|daddy|sister|brother|grandma|grandpa|friend|cousin|aunt|uncle|cat|dog|puppy|kitten|hamster|fish|bunny|horse)s (?=(room|house|car|bed|phone|office|work|birthday|friend|dog|cat|toys?|lap|side|name|bowl|food|tail|collar|cage|leash)\\b)",
      "ignore_case": true,
      "replace": "\\1's ",
      "examples": [
        [
          "my moms room",
          "my mom's room"
        ],
        [
          "what is my cats name",
          "what is my cat's name"
        ]
      ]
    },
    {
      "note": "\"a dog named max\" -> \"a dog named Max\"",
      "pattern": "\\b(named|called) (?!(after|it|him|her|them|me|you|us|that|this|what|a|an|the|my)\\b)([a-z])",
      "template": "{1} {3|upper}",
      "examples": [
        [
          "my dog is calld rex",
          "my dog is called Rex"
        ],
        [
          "I have a dog named max",
          "I have a dog named Max"
        ]
      ]
    },
    {
      "note": "\"his name is max\" -> \"his name is Max\"",
      "pattern": "\\b(name (?:is|was|'s)) (?!(not|a|an|the|my|so|really|very|too|kind|cool|weird|nice|funny|silly|pretty|great|awesome|beautiful|long|short|hard|easy|dumb|stupid|ugly|cute|good|bad|special|unique|strange|boring|perfect|fine|ok|okay|lovely|fancy|same|different|tricky|interesting)\\b)([a-z])",
      "template": "{1} {3|upper}",
      "examples": [
        [
          "my nme is jak",
          "my name is Jak"
        ],
        [
          "my name is sam",
          "my name is Sam"
        ]
      ]
    },
    {
      "note": "\"their names are max and coco\" -> \"... Max and Coco\"",
      "pattern": "\\b(names are) ([a-z]+) and ([a-z]+)\\b",
      "template": "{1} {2|capitalize} and {3|capitalize}",
      "examples": [
        [
          "their names are luna and milo",
          "their names are Luna and Milo"
        ]
      ]
    },
    {
      "note": "Place names (\"texas\" -> \"Texas\")",
      "pattern": "\\b({words})\\b",
      "template": "{1|title}",
      "word_list": [
