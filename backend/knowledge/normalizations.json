    {
      "note": "Titles of songs, games and shows (the parser's _TITLES table, also used by the reference tracker)",
      "code": "titles",
      "examples": [
        [
          "roblox",
          "Roblox"
        ],
        [
          "my pokemon",
          "my Pokémon"
        ]
      ]
    },
    {
      "note": "\"on saturday\" -> \"on Saturday\" (\"may\" and \"march\" are also words, so they stay)",
      "pattern": "\\b(monday|tuesday|wednesday|thursday|friday|saturday|sunday|january|february|april|june|july|august|september|october|november|december)\\b",
      "template": "{1|capitalize}",
      "examples": [
        [
          "june",
          "June"
        ],
        [
          "im june",
          "I'm June"
        ]
      ]
    },
    {
      "note": "\"its fun\" (the whole message) -> \"it's fun\"; not \"its wings\"",
      "pattern": "^its (?=[a-z]*[a-rt-z][.!]*$)",
      "ignore_case": true,
      "replace": "it's ",
      "examples": [
        [
          "its math",
          "it's math"
        ]
      ]
    },
    {
      "note": "\"buddy do you like pizza\": the bot's name before a question is dropped",
      "pattern": "^buddy,? (?=(?:do|does|did|can|could|will|would|are|guess|what|why|how|where|who|when|i|you|look|listen|tell|let's|lets|wanna|want)\\b)",
      "ignore_case": true,
      "replace": "",
      "examples": [
        [
          "buddy do you like pizza",
          "do you like pizza"
        ]
      ]
    },
    {
      "note": "\"hey buddy guess what\": the greeting is set off by a comma",
      "pattern": "^((?:hey|hi|hello) buddy)(?= (?:do|does|did|can|could|will|would|are|guess|what|why|how|where|who|when|i|you|look|listen|tell|let's|lets|wanna|want)\\b)",
      "ignore_case": true,
      "replace": "\\1,",
      "examples": [
        [
          "hey buddy guess what",
          "hey buddy, guess what"
        ]
      ]
    },
    {
      "note": "\"i love you buddy\": the name at the end is dropped",
      "pattern": "\\b(you|thanks|bye|goodnight|night),? buddy\\s*([.!?]*)$",
      "ignore_case": true,
      "replace": "\\1\\2",
      "examples": [
        [
          "bye buddy",
          "bye"
        ],
        [
          "ok bye buddy",
          "ok bye"
        ]
      ]
    },
    {
      "note": "\"home.it was fun\": a sentence run together after the period",
      "pattern": "(?<=[a-z])\\.(?=(?:i|it|we|he|she|they|my|the|then|and|but|so|you|that|there|this)\\b)",
      "replace": ". ",
      "examples": [
        [
          "i went home.it was fun",
          "I went home. it was fun"
        ]
      ]
    },
    {
      "note": "\"my mom n dad\", \"me & my sister\" -> \"and\"",
      "pattern": "(?<=\\w) (?:n|&|\\+) (?=\\w)",
      "replace": " and ",
      "examples": [
        [
          "me & my sister made cookies",
          "my sister and I made cookies"
        ],
        [
          "my mom n dad took me to the park",
          "my mom and dad took me to the park"
        ]
      ]
    },
    {
      "note": "\"w/ my grandma\" -> \"with my grandma\"",
      "pattern": "\\bw/(?=\\s)",
      "ignore_case": true,
      "replace": "with",
      "examples": [
        [
          "i went w/ my grandma",
          "I went with my grandma"
        ]
      ]
    },
    {
      "note": "\"going 2 the store\" -> \"going to the store\" (\"I have 2 dogs\" stays)",
      "pattern": "\\b(go|going|went|goes|come|came|want|wanna|have|need|got|talk|listen|back|up|next|way|time|to|due) 2 (?=(?:the|my|a|school|bed|sleep|play|go|eat|be|see|get|do|work|church|grandma's|grandpa's)\\b)",
      "ignore_case": true,
      "replace": "\\1 to ",
      "examples": [
        [
          "i'm going 2 the store",
          "I'm going to the store"
        ],
        [
          "i have 2 dogs",
          "I have 2 dogs"
        ]
      ]
    },
    {
      "note": "\"you like pizza right\" -> \"do you like pizza?\"; \"dogs are cute aren't they\" -> \"dogs are cute\"; \"that's right\" stays",
      "code": "tag_question",
      "examples": [
        [
          "you like pizza right",
          "do you like pizza?"
        ],
        [
          "dogs are cute aren't they",
          "dogs are cute"
        ]
      ]
    },
    {
      "note": "\"i dare you to say something funny\": the dare is the request",
      "pattern": "^i (?:dare|double dare|triple dare) you to ",
      "ignore_case": true,
      "replace": "",
      "examples": [
        [
          "i dare you to say something funny",
          "say something funny"
        ]
      ]
    },
    {
      "note": "\"I'm a dinosaur rawr\": the growl is its own sentence",
      "pattern": "(?<=[a-z])\\s+((?:rawr+|roa+r+|grr+|meow+|woof+|moo+|oink+)\\W*)$",
      "ignore_case": true,
      "replace": "! \\1",
      "examples": [
        [
          "i'm a dinosaur rawr",
          "I'm a dinosaur! rawr"
        ]
      ]
    },
    {
      "note": "\"y'all\" -> \"you all\"",
      "pattern": "\\by'?all\\b",
      "ignore_case": true,
      "replace": "you all",
      "examples": [
        [
          "y'all are funny",
          "you all are funny"
        ]
      ]
    },
    {
      "note": "\"which is better pizza or tacos\": a comma before the choices",
      "pattern": "^((?:which|what)(?: one)? (?:is|do you like|would you pick|do you pick|would you choose)(?: better| more| best)?),?\\s+(\\w+(?: \\w+)?) or (\\w+(?: \\w+)?)\\s*\\??$",
      "ignore_case": true,
      "replace": "\\1, \\2 or \\3?",
      "examples": [
        [
          "which is better pizza or tacos",
          "which is better, pizza or tacos?"
        ]
      ]
    },
    {
      "note": "Quotes around what someone said: 'my mom said \"no way\"'",
      "pattern": "[\\\"“”]",
      "replace": "",
      "examples": [
        [
          "my mom said \"no way\"",
          "my mom said no way"
        ],
        [
          "she said “stop”",
          "she said stop"
        ]
      ]
    },
    {
      "note": "\"what do i do\": asking for advice",
      "pattern": "^what do i do\\b",
      "ignore_case": true,
      "replace": "what should I do",
      "examples": [
        [
          "what do i do if i'm scared",
          "what should I do if I'm scared"
        ]
      ]
    },
    {
      "note": "\"what does gravity mean\" -> \"what is gravity\" (the world answers' form)",
      "pattern": "^what does (?!(?:that|it|this|he|she|they|you|mine)\\b)([\\w ]+?) mean\\b",
      "ignore_case": true,
      "replace": "what is \\1",
      "examples": [
        [
          "what does gravity mean",
          "what is gravity"
        ]
      ]
    },
    {
      "note": "\"i watched frozen\": a movie title after a word for watching",
      "pattern": "\\b(watch|watched|watching|saw|seen|see|love|loved|like|liked)( the movie)? (frozen|moana|encanto|coco|elemental|luca|tangled|bluey|trolls|turning red|inside out|toy story|zootopia|minions|despicable me|shrek|wicked|lilo and stitch|the lion king)(?=\\s*(?:[.!?,]|$)|\\s+(?:and|with|today|yesterday|again|last|at|on|tonight|so|too|two|2)\\b)",
      "ignore_case": true,
      "template": "{1}{2} {3|title_and}",
      "examples": [
        [
          "i watched frozen",
          "I watched Frozen"
        ],
        [
          "do you like frozen",
          "do you like Frozen"
        ]
      ]
    },
    {
      "note": "\"i wonder why the sky is blue\" -> \"why is the sky blue?\"",
      "pattern": "^i (?:wonder|want to know|wanna know|wish i knew) (why|how|where|what|when) ((?:the |a |my |your )?\\w+) (is|are|was|were|can|do|does) (.+?)[.!?]*$",
      "ignore_case": true,
      "template": "{1} {3} {2} {4}?",
      "examples": [
        [
          "i wonder why the sky is blue",
          "why is the sky blue?"
        ]
      ]
    },
    {
      "note": "\"i wonder if dogs can swim\" -> \"can dogs swim?\"",
      "pattern": "^i (?:wonder|want to know|wanna know|wish i knew) if ((?:the |a |my |your )?\\w+) (is|are|was|were|can|do|does) (.+?)[.!?]*$",
      "ignore_case": true,
      "template": "{2} {1} {3}?",
      "examples": [
        [
          "i wonder if dogs can swim",
          "can dogs swim?"
        ]
      ]
    },
    {
      "note": "\"y is the sky blue\", \"y not\": \"why\"",
      "pattern": "^y(?= (is|are|do|does|did|not|can|can't|would|wouldn't|should|won't|cant|dont|don't|was|were)\\b)|^y(?=\\W*$)",
      "ignore_case": true,
      "replace": "why",
      "examples": [
        [
          "y not",
          "why not"
        ],
        [
          "y is the sky blue",
          "why is the sky blue"
        ]
      ]
    },
    {
      "note": "\"lets fish\" at the start: \"let's fish\"",
      "pattern": "^lets\\b",
      "ignore_case": true,
      "replace": "let's",
      "examples": [
        [
          "lets race",
          "let's race"
        ],
        [
          "lets paint",
          "let's paint"
        ]
      ]
    },
    {
      "note": "\"me and lily played tag\" -> \"lily and I played tag\" (the parser reads \"me and\" badly)",
      "pattern": "(^|[.!?] )me and ((?:my |our )?(?!my\\b|our\\b)[a-z]+)(?= [a-z])",
      "ignore_case": true,
      "template": "{1}{2|subject} and I",
      "examples": [
        [
          "me and lily played tag",
          "lily and I played tag"
        ],
        [
          "me and him built a fort",
          "he and I built a fort"
        ],
        [
          "me and my friend went",
          "my friend and I went"
        ]
      ]
    },
    {
      "note": "\"mr smith\" -> \"Mr Smith\"",
      "pattern": "\\b(mr|mrs|ms|dr)\\.? ([a-z])",
      "ignore_case": true,
      "template": "{1|capitalize} {2|upper}",
      "examples": [
        [
          "my teacher mr kim",
          "my teacher Mr Kim"
        ],
        [
          "my coach is mr lee",
          "my coach is Mr Lee"
        ]
      ]
    },
    {
      "note": "\"what's your name and how old are you\": two questions, answered one by one",
      "pattern": ",?\\s+and\\s+(?=(how|what|where|when|why|who|do you|are you|can you|will you)\\b)",
      "ignore_case": true,
      "replace": "? ",
      "only_if": {
        "pattern": "^(what|how|where|when|why|who|do|does|are|is|can|will)\\b",
        "ignore_case": true
      },
      "examples": [
        [
          "whats your name and how old are you",
          "what's your name? how old are you"
        ],
        [
          "what is your favorite animal and why",
          "what is your favorite animal? why"
        ]
      ]
    }
  ]
}